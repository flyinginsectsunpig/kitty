# Copy to .env.local for `pnpm dev` outside Aspire (Aspire sets these for you).
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=kitty-web
AUTH_KEYCLOAK_SECRET=dev-only-kitty-web-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/kitty
LEDGER_URL=http://localhost:5080
