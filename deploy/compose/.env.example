# Copy to deploy/compose/.env on the server and fill in. Never commit the real file.

# Public hostname, e.g. a free DuckDNS name: kitty-yourname.duckdns.org
KITTY_HOST=
# Images from CI: ghcr.io/<github-owner-lowercase>/   (note the trailing slash)
KITTY_IMAGE_PREFIX=ghcr.io/your-github-user/
# "latest" or a specific CI tag such as sha-1a2b3c4
KITTY_TAG=latest

# Generate each with:  openssl rand -base64 32
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
AUTH_SECRET=
KITTY_WEB_CLIENT_SECRET=

# Verification emails (Resend free tier: SMTP user "resend", password = API key)
SMTP_FROM=kitty@your-verified-domain.example
SMTP_PASSWORD=
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465

# Optional Google sign-in
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
