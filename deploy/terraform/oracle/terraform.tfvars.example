# Copy to terraform.tfvars (git-ignored) and fill in. Look the values up with the OCI CLI (deploy/k3s/RUNBOOK.md).
tenancy_ocid             = "<tenancy OCID>"
compartment_ocid         = "<compartment OCID: the tenancy OCID when using the root compartment>"
object_storage_namespace = "<oci os ns get>"
budget_alert_email       = "<where the budget alert goes>"
availability_domain      = "<the server's availability domain>"
ubuntu_image_ocid        = "<the server's source image OCID>"
ssh_public_key           = "<the server's SSH public key>"

existing = {
  instance          = "<instance OCID>"
  vcn               = "<VCN OCID>"
  subnet            = "<subnet OCID>"
  internet_gateway  = "<internet gateway OCID>"
  budget            = "<budget OCID>"
  budget_alert_rule = "<alert rule OCID>"
  lifecycle_policy  = "<kitty-backups-lifecycle IAM policy OCID>"
}
