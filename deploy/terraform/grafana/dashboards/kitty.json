{
  "uid": "kitty",
  "title": "Kitty",
  "description": "Kitty in production: what people do, how fast it answers, and whether the platform is healthy (phase 5b).",
  "schemaVersion": 39,
  "editable": false,
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "5m",
  "templating": {
    "list": [
      { "name": "datasource", "label": "Metrics", "type": "datasource", "query": "prometheus", "current": {} }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Expenses per day",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "sum by (split_type) (increase(kitty_expenses_created_total[1d]))", "legendFormat": "{{split_type}}" }]
    },
    {
      "id": 2, "type": "stat", "title": "Receipt read success rate",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [{ "refId": "A", "expr": "sum(increase(kitty_receipts_read_total{outcome=\"parsed\"}[7d])) / sum(increase(kitty_receipts_read_total[7d]))" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Receipts and sentences by outcome",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (increase(kitty_receipts_read_total[1d]))", "legendFormat": "receipt {{outcome}}" },
        { "refId": "B", "expr": "sum by (outcome) (increase(kitty_sentences_parsed_total[1d]))", "legendFormat": "sentence {{outcome}}" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "p95 response time",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_request_duration_seconds_bucket[5m])))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Error rate",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "refId": "A", "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m])) / sum by (job) (rate(http_server_request_duration_seconds_count[5m]))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Model calls",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "sum by (kind, result) (increase(kitty_model_calls_total[1h]))", "legendFormat": "{{kind}} {{result}}" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Pod memory",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "refId": "A", "expr": "sum by (k8s_pod_name) (k8s_pod_memory_usage_bytes{k8s_namespace_name=\"kitty\"})", "legendFormat": "{{k8s_pod_name}}" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "Pod restarts",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "sum by (k8s_pod_name) (k8s_container_restarts{k8s_namespace_name=\"kitty\"})", "legendFormat": "{{k8s_pod_name}}" }]
    },
    {
      "id": 9, "type": "stat", "title": "Last backup",
      "gridPos": { "x": 0, "y": 24, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "h", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 26 }] } } },
      "options": { "colorMode": "background" },
      "targets": [{ "refId": "A", "expr": "(time() - max(max_over_time(kitty_backup_last_success_seconds[2d]))) / 3600" }]
    },
    {
      "id": 10, "type": "stat", "title": "Certificate days left",
      "gridPos": { "x": 6, "y": 24, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "d", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 14 }] } } },
      "options": { "colorMode": "background" },
      "targets": [{ "refId": "A", "expr": "(min(certmanager_certificate_expiration_timestamp_seconds) - time()) / 86400" }]
    },
    {
      "id": 11, "type": "timeseries", "title": "Notifications sent",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "sum by (channel, result) (increase(kitty_notifications_sent_total[1d]))", "legendFormat": "{{channel}} {{result}}" }]
    }
  ]
}
