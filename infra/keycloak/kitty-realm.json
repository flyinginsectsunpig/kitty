{
  "realm": "kitty",
  "enabled": true,
  "displayName": "Kitty",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": "${KITTY_VERIFY_EMAIL:true}",
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "offlineSessionIdleTimeout": 7776000,
  "bruteForceProtected": true,
  "smtpServer": {
    "host": "${SMTP_HOST:mailpit}",
    "port": "${SMTP_PORT:1025}",
    "from": "${SMTP_FROM:kitty@localhost}",
    "fromDisplayName": "Kitty",
    "auth": "${SMTP_AUTH:false}",
    "user": "${SMTP_USER:}",
    "password": "${SMTP_PASSWORD:}",
    "starttls": "${SMTP_STARTTLS:false}",
    "ssl": "${SMTP_SSL:false}"
  },
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "clients": [
    {
      "clientId": "kitty-web",
      "name": "Kitty web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KITTY_WEB_CLIENT_SECRET:dev-only-kitty-web-secret}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "${KITTY_PUBLIC_URL:http://localhost:3000}/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##${KITTY_PUBLIC_URL:http://localhost:3000}/*"
      },
      "protocolMappers": [
        {
          "name": "kitty-ledger-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "kitty-ledger",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "kitty-mobile",
      "name": "Kitty app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["kitty://auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "kitty://auth/callback"
      },
      "protocolMappers": [
        {
          "name": "kitty-ledger-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "kitty-ledger",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "kitty-pulse",
      "name": "pulse (service)",
      "description": "pulse's own identity for adding recurring expenses through the ledger's internal gRPC port.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${PULSE_CLIENT_SECRET:dev-only-kitty-pulse-secret}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "kitty-ledger-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "kitty-ledger",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "displayName": "Google",
      "enabled": "${GOOGLE_ENABLED:false}",
      "trustEmail": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID:unset}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET:unset}",
        "syncMode": "IMPORT"
      }
    }
  ]
}
